# PostgreSQL connection string
DATABASE_URL="postgresql://rljit_user:CHANGE_ME@localhost:5432/rljit_cse_challenge?schema=public"

# JWT signing secret — generate with `openssl rand -base64 48`
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Access token lifetime, in seconds (default 8 hours — covers a full test window)
JWT_EXPIRES_IN_SECONDS=28800

# Bcrypt cost factor
BCRYPT_SALT_ROUNDS=12

# Base URL of the isolated code-execution/judge service (Phase 5). Never point this
# at the main app server itself.
JUDGE_SERVICE_URL="http://localhost:4001"
JUDGE_SERVICE_TOKEN="CHANGE_ME_INTERNAL_SERVICE_TOKEN"

# Node environment
NODE_ENV="development"
